# https://www.printables.com/model/1362668-skeletor-mk7-side-mounted-cartographer-integration

-- cartographer.cfg
[cartographer]
x_offset: -24.0
y_offset: 0.0

[bed_mesh]
mesh_min: 10,10
mesh_max: 200,215

[screws_tilt_adjust]
screw1:53.50, 25
screw2:223.50, 25
screw3:223.50, 194.50
screw4:53.50, 194.50

-- printer.cfg
[stepper_y]
position_max: 226
